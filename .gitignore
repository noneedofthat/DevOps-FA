# dependencies (ignores root and backend node_modules)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js & backend builds
/.next/
/out/
/build
dist/
backend/dist/

# terraform infrastructure state and local configurations
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.backup
terraform/.terraform.lock.hcl

# ansible local inventory and private keys
ansible/inventory.ini
*.pem

# misc
.DS_Store
codebase_*.txt
.sf/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# runtime stores
.data/

# env files (ignore local secrets, explicitly allow .env.example)
.env
.env*.local
.env.local
backend/.env
!.env.example
!backend/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# uploads
backend/uploads/
uploads/
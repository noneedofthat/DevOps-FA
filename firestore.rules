rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to verify user authentication
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Helper function to verify faculty administrator privilege
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'FACULTY_ADMIN' ||
        request.auth.token.admin == true ||
        request.auth.token.email.matches('.*@pccoepune[.]org$')
      );
    }

    // Teams Collection Security Rules (BOLA / IDOR Protection)
    match /teams/{teamId} {
      // Any authenticated participant can read team listings
      allow read: if isAuthenticated();

      // Only authenticated users can create a team, and must set themselves as leader/member
      allow create: if isAuthenticated() && (
        request.resource.data.leaderUid == request.auth.uid ||
        request.auth.uid in request.resource.data.members
      );

      // Only existing team members or team leader can update team details
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.leaderUid ||
        request.auth.uid in resource.data.members ||
        isAdmin()
      );

      // Only the team leader or faculty admin can disband a team
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.leaderUid ||
        isAdmin()
      );
    }

    // Project Submissions Collection (Row-Level Security)
    match /submissions/{submissionId} {
      // Submissions are readable by authenticated users and judges
      allow read: if isAuthenticated();

      // Participants can only submit on their own behalf
      allow create: if isAuthenticated() && 
        request.resource.data.submittedByUid == request.auth.uid;

      // Submissions can only be edited by the submitter or an admin
      allow update: if isAuthenticated() && (
        resource.data.submittedByUid == request.auth.uid ||
        isAdmin()
      );

      // Only admins can delete submission records
      allow delete: if isAdmin();
    }

    // Judge Evaluations Collection (RBAC - Faculty / Judges Only)
    match /evaluations/{evaluationId} {
      // Evaluations are readable by all authenticated participants on leaderboard
      allow read: if isAuthenticated();

      // Only verified faculty admins and judges can write or mutate scores
      allow create, update, delete: if isAdmin();
    }

    // Catch-all: Deny all unhandled paths by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
